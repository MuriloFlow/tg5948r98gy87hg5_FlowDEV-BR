# ============================================================================
# FlowDesk — variáveis de ambiente
# Copie para .env.local e preencha. Nunca versione o .env.local.
# ============================================================================

# ---------------------------------------------------------------- Supabase --
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://flowdev.db.flwdesk.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave service_role. Só existe no servidor — nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Conexão direta com o Postgres — usada só pelos scripts `npm run db:push`
# e `npm run db:seed`. Settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# --------------------------------------------------------------- Aplicação --
# URL de runtime do painel (redirects internos).
# Local: http://localhost:3000  |  Produção: https://flowdeskbrasil.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública para links enviados a clientes (checkout /pay/..., cobranças, API).
# Quando NEXT_PUBLIC_APP_URL for localhost, links copiados no painel usam esta URL.
NEXT_PUBLIC_PUBLIC_URL=https://flowdeskbrasil.vercel.app

# Segredo usado para assinar os cookies de sessão do painel.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FLOWDESK_SESSION_SECRET=

# ----------------------------------------------------------- Mercado Pago --
# Suas integrações → Credenciais de produção (ou de teste)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# Assinatura do webhook: Suas integrações → Webhooks → Chave secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Destino do webhook do Mercado Pago. Só é enviado ao gateway quando é uma URL
# pública em HTTPS — em localhost o campo é omitido e a confirmação passa a
# depender do polling do checkout. Para testar o webhook em desenvolvimento,
# suba um túnel (ex.: `ngrok http 3000`) e aponte esta variável para ele:
# MERCADOPAGO_NOTIFICATION_URL=https://SEU-TUNEL.ngrok-free.app/api/webhooks/mercadopago
MERCADOPAGO_NOTIFICATION_URL=

# --------------------------------------------------------------------- Cron --
# Protege /api/cron/billing. A Vercel envia este valor automaticamente.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
